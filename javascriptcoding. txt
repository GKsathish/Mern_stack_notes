9.  THREE SUM - UNIQUE TRIPLETS THAT SUM TO ZERO

function threeSum(arr) { let result = []; let sorted = […arr].sort((a,
b) => a - b);

    for (let i = 0; i < sorted.length - 2; i++) {
        if (i > 0 && sorted[i] === sorted[i - 1]) {
            continue;
        }

        let left = i + 1;
        let right = sorted.length - 1;

        while (left < right) {
            let sum = sorted[i] + sorted[left] + sorted[right];

            if (sum === 0) {
                result.push([sorted[i], sorted[left], sorted[right]]);
                left++;
                right--;

                while (left < right && sorted[left] === sorted[left - 1]) {
                    left++;
                }

                while (left < right && sorted[right] === sorted[right + 1]) {
                    right--;
                }
            } else if (sum < 0) {
                left++;
            } else {
                right--;
            }
        }
    }

    return result;

}

console.log(threeSum([-1, 0, 1, 2, -1, -4])); // [[-1, -1, 2], [-1, 0,
1]]

10. MAXIMUM CONSECUTIVE ONES

function maxConsecutiveOnes(arr) { let count = 0; let max = 0;

    for (let i = 0; i < arr.length; i++) {
        if (arr[i] === 1) {
            count++;

            if (count > max) {
                max = count;
            }
        } else {
            count = 0;
        }
    }

    return max;

}

