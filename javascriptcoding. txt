12. CHECK PALINDROME

function isPalindrome(str) { let left = 0; let right = str.length - 1;

    while (left < right) {
        if (str[left] !== str[right]) {
            return false;
        }

        left++;
        right--;
    }

    return true;

}

console.log(isPalindrome(“madam”)); // true

13. REVERSE A STRING

function reverseString(str) { let result = ““;

    for (let i = str.length - 1; i >= 0; i--) {
        result += str[i];
    }

    return result;

}

console.log(reverseString(“javascript”)); // tpircsavaj

14. REVERSE WORD ORDER

function reverseWordOrder(str) { let words = str.trim().split(/+/); let
result = ““;

    for (let i = words.length - 1; i >= 0; i--) {
        result += words[i];

        if (i !== 0) {
            result += " ";
        }
    }

    return result;

}

console.log(reverseWordOrder(“I love JavaScript”)); // JavaScript love I

15. REVERSE EACH WORD, KEEP WORD ORDER

function reverseEachWord(str) { let words = str.split(” “); let result =
[];

    for (let i = 0; i < words.length; i++) {
        let reversed = "";

        for (let j = words[i].length - 1; j >= 0; j--) {
            reversed += words[i][j];
        }

        result.push(reversed);
    }

    return result.join(" ");

}

console.log(reverseEachWord(“hello world”)); // olleh dlrow

