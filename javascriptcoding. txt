17. CHECK ANAGRAM

function isAnagram(str1, str2) { let a = str1.toLowerCase().replace(//g,
““); let b = str2.toLowerCase().replace(//g,”“);

    if (a.length !== b.length) {
        return false;
    }

    let counts = {};

    for (let i = 0; i < a.length; i++) {
        let ch = a[i];
        counts[ch] = (counts[ch] || 0) + 1;
    }

    for (let i = 0; i < b.length; i++) {
        let ch = b[i];

        if (!counts[ch]) {
            return false;
        }

        counts[ch]--;
    }

    return true;

}

console.log(isAnagram(“listen”, “silent”)); // true

