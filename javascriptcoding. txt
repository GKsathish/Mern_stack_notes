7.  MOVE ZEROS TO END

function moveZeros(arr) { 
    let result = [];

    for (let i = 0; i < arr.length; i++) {
        if (arr[i] !== 0) {
            result.push(arr[i]);
        }
    }

    while (result.length < arr.length) {
        result.push(0);
    }

    return result;

}

