24. GROUP USERS BY ROLE

function groupByRole(users) { let result = {};

    for (let i = 0; i < users.length; i++) {
        let role = users[i].role;

        if (!result[role]) {
            result[role] = [];
        }

        result[role].push(users[i].name);
    }

    return result;

}

let users = [ { name: “Asha”, role: “admin” }, { name: “Ravi”, role:
“user” }, { name: “Sam”, role: “admin” }];

console.log(groupByRole(users)); // { admin: [“Asha”, “Sam”], user:
[“Ravi”] }

25. ARRAY OF OBJECTS TO OBJECT BY ID

function convertById(users) { let result = {};

    for (let i = 0; i < users.length; i++) {
        result[users[i].id] = users[i];
    }

    return result;

}

let employees = [ { id: 1, name: “Asha” }, { id: 2, name: “Ravi” }];

console.log(convertById(employees)); // { 1: { id: 1, name: “Asha” }, 2:
{ id: 2, name: “Ravi” } }

26. MERGE TWO OBJECTS

function mergeObjects(obj1, obj2) { let result = {};

    for (let key in obj1) {
        if (Object.hasOwn(obj1, key)) {
            result[key] = obj1[key];
        }
    }

    for (let key in obj2) {
        if (Object.hasOwn(obj2, key)) {
            result[key] = obj2[key];
        }
    }

    return result;

}

console.log(mergeObjects( { name: “Asha”, age: 25 }, { age: 26, city:
“Hyderabad” } )); // { name: “Asha”, age: 26, city: “Hyderabad” }

