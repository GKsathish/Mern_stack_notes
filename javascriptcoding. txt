28. FIND KEY WITH MAXIMUM VALUE

function keyWithMaxValue(obj) { let keys = Object.keys(obj);

    if (keys.length === 0) {
        return null;
    }

    let maxKey = keys[0];

    for (let i = 1; i < keys.length; i++) {
        if (obj[keys[i]] > obj[maxKey]) {
            maxKey = keys[i];
        }
    }

    return maxKey;

}

console.log(keyWithMaxValue({ a: 10, b: 25, c: 15 })); // b

29. FLATTEN A NESTED OBJECT

function flattenObject(obj, prefix = ““, result = {}) { for (let key in
obj) { if (!Object.hasOwn(obj, key)) { continue; }

        let newKey = prefix ? prefix + "." + key : key;
        let value = obj[key];

        if (value !== null && typeof value === "object" && !Array.isArray(value)) {
            flattenObject(value, newKey, result);
        } else {
            result[newKey] = value;
        }
    }

    return result;

}

let data = { user: { name: “Asha”, address: { city: “Hyderabad” } } };

console.log(flattenObject(data)); // { “user.name”: “Asha”,
“user.address.city”: “Hyderabad” }

30. K ELEMENTS THAT SUM TO A TARGET

function combinationsSumTarget(arr, k, target) { let result = [];

    function backtrack(start, current, sum) {
        if (current.length === k) {
            if (sum === target) {
                result.push([...current]);
            }
            return;
        }

        for (let i = start; i < arr.length; i++) {
            current.push(arr[i]);

            backtrack(i + 1, current, sum + arr[i]);

            current.pop();
        }
    }

    backtrack(0, [], 0);
    return result;

}

console.log(combinationsSumTarget([1, 2, 3, 4, 5], 2, 6)); // [[1, 5],
[2, 4]]

